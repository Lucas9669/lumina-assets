// src/main.js
import Phaser from 'phaser';

// ==========================================
// CENA 1: TELA DE TÍTULO
// ==========================================
class BootScene extends Phaser.Scene {
    constructor() { super('BootScene'); }
    preload() {
        this.load.image('fundoTitulo', 'https://raw.githubusercontent.com/Lucas9669/lumina-assets/main/assets/backgrounds/Titulo.png');
        this.load.image('fundoMenu', 'https://raw.githubusercontent.com/Lucas9669/lumina-assets/main/assets/backgrounds/Menu%20principal.png');
    }
    create() {
        this.cameras.main.fadeIn(500, 0, 0, 0);

        const cx = this.cameras.main.width / 2;
        const cy = this.cameras.main.height / 2;
        const bg = this.add.image(cx, cy, 'fundoTitulo');
        bg.setDisplaySize(this.cameras.main.width, this.cameras.main.height);

        this.tweens.add({ targets: bg, scaleX: bg.scaleX * 1.1, scaleY: bg.scaleY * 1.1, x: cx + 30, y: cy + 15, duration: 15000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });

        this.game.events.off('START_MAIN_MENU_TRANSITION');
        this.game.events.once('START_MAIN_MENU_TRANSITION', () => {
            this.cameras.main.fadeOut(1000, 0, 0, 0);
            this.cameras.main.once(Phaser.Cameras.Scene2D.Events.FADE_OUT_COMPLETE, () => {
                this.scene.start('MainMenuScene');
            });
        });
    }
}

// ==========================================
// CENA 2: MENU PRINCIPAL
// ==========================================
class MainMenuScene extends Phaser.Scene {
    constructor() { super('MainMenuScene'); }
    create() {
        this.cameras.main.fadeIn(1000, 0, 0, 0);
        const cx = this.cameras.main.width / 2;
        const cy = this.cameras.main.height / 2;
        const bgMenu = this.add.image(cx, cy, 'fundoMenu');
        bgMenu.setDisplaySize(this.cameras.main.width, this.cameras.main.height);

        this.tweens.add({ targets: bgMenu, scaleX: bgMenu.scaleX * 1.05, scaleY: bgMenu.scaleY * 1.05, x: cx - 20, y: cy - 10, duration: 18000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });

        this.cameras.main.once(Phaser.Cameras.Scene2D.Events.FADE_IN_COMPLETE, () => {
            this.game.events.emit('SHOW_MAIN_MENU_UI');
        });

        this.game.events.off('LOGOUT_TRANSITION');
        this.game.events.once('LOGOUT_TRANSITION', () => {
            this.cameras.main.fadeOut(500, 0, 0, 0);
            this.cameras.main.once(Phaser.Cameras.Scene2D.Events.FADE_OUT_COMPLETE, () => {
                this.scene.start('BootScene');
                this.game.events.emit('SHOW_LOGIN_UI');
            });
        });
    }
}

const config = { type: Phaser.AUTO, parent: 'game-container', width: 1920, height: 1080, scale: { mode: Phaser.Scale.FIT, autoCenter: Phaser.Scale.CENTER_BOTH }, scene: [BootScene, MainMenuScene] };
const game = new Phaser.Game(config);

// ==========================================
// CAMADA LÓGICA: INTERFACE, AUTO-LOGIN E API
// ==========================================
const gameContainer = document.getElementById('game-container');
const loginUI = document.getElementById('login-ui');
const mainMenuUI = document.getElementById('main-menu-ui');
const initialButtons = document.getElementById('initial-buttons');
const formBox = document.getElementById('form-box');
const formTitle = document.getElementById('form-title');
const btnSubmit = document.getElementById('btn-submit');
const loadingMsg = document.getElementById('loading-msg');
const autoLoginMsg = document.getElementById('auto-login-msg');

let isLoginMode = false;
const API_URL = 'https://script.google.com/macros/s/AKfycbzq3AXkjlYLxcuvL9NR22OqD_uJA-oHgks0_zSGWJ_cSqezz0hX_si_WkXkRKvHus0EGA/exec';

async function performAuth(email, pass, action) {
    const payload = { action: action, email: email, senha: pass };
    
    try {
        const response = await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload)
        });
        const data = await response.json();

        if (data.status === "success") {
            localStorage.setItem('lumina_email', email);
            localStorage.setItem('lumina_pass', pass);

            const username = email.split('@')[0].toUpperCase();
            document.getElementById('display-username').innerText = username;
            document.getElementById('display-gems').innerText = data.gems || 0;

            loginUI.style.display = 'none';
            gameContainer.className = ''; 
            game.events.emit('START_MAIN_MENU_TRANSITION');
        } else {
            localStorage.removeItem('lumina_email');
            localStorage.removeItem('lumina_pass');
            resetLoginUI(data.message || "Erro de autenticação.");
        }
    } catch (error) {
        console.error("Erro na API:", error);
        resetLoginUI("Erro de conexão com o servidor.");
    }
}

function resetLoginUI(errorText) {
    loadingMsg.innerText = errorText;
    loadingMsg.style.color = "red";
    btnSubmit.disabled = false;
    btnSubmit.style.opacity = '1';
    autoLoginMsg.style.display = 'none';
    initialButtons.style.display = 'flex';
}

window.addEventListener('DOMContentLoaded', () => {
    const savedEmail = localStorage.getItem('lumina_email');
    const savedPass = localStorage.getItem('lumina_pass');

    if (savedEmail && savedPass) {
        initialButtons.style.display = 'none';
        autoLoginMsg.style.display = 'block';
        gameContainer.className = 'bg-blurred';
        performAuth(savedEmail, savedPass, 'login');
    }
});

function openForm(isLogin) {
    isLoginMode = isLogin;
    initialButtons.style.display = 'none'; 
    formBox.style.display = 'block'; 
    gameContainer.className = 'bg-blurred'; 
    formTitle.innerText = isLogin ? "Entrar no Lumina" : "Registrar no Lumina";
    btnSubmit.innerText = isLogin ? "Fazer Login" : "Criar Conta";
}

document.getElementById('btn-new-game').addEventListener('click', () => openForm(false));
document.getElementById('btn-login').addEventListener('click', () => openForm(true));
document.getElementById('btn-back').addEventListener('click', () => {
    initialButtons.style.display = 'flex'; formBox.style.display = 'none'; loadingMsg.style.display = 'none'; gameContainer.className = ''; 
});

btnSubmit.addEventListener('click', () => {
    const email = document.getElementById('userEmail').value;
    const pass = document.getElementById('userPass').value;
    if (!email || !pass) return alert("Por favor, preencha email e senha!");

    loadingMsg.style.display = 'block';
    loadingMsg.innerText = "Conectando ao banco de dados...";
    loadingMsg.style.color = "#00E5FF";
    btnSubmit.disabled = true;
    btnSubmit.style.opacity = '0.5';

    performAuth(email, pass, isLoginMode ? 'login' : 'register');
});

// ==========================================
// EVENTOS DE ANIMAÇÃO DO MENU
// ==========================================
game.events.on('SHOW_MAIN_MENU_UI', () => {
    mainMenuUI.style.display = 'block';
    // Um pequeno delay para a classe active ativar as animações CSS
    setTimeout(() => {
        mainMenuUI.classList.add('active'); 
    }, 50);
    gameContainer.className = 'bg-light-blur'; 
});

game.events.on('SHOW_LOGIN_UI', () => {
    loginUI.style.display = 'flex';
    initialButtons.style.display = 'flex';
    formBox.style.display = 'none';
    autoLoginMsg.style.display = 'none';
    gameContainer.className = ''; 
});

// ==========================================
// EVENTO DE LOGOFF
// ==========================================
document.getElementById('btn-logout').addEventListener('click', () => {
    localStorage.removeItem('lumina_email');
    localStorage.removeItem('lumina_pass');

    // Remove a classe active para que a animação possa rodar de novo da próxima vez
    mainMenuUI.classList.remove('active');
    setTimeout(() => {
        mainMenuUI.style.display = 'none';
    }, 300); // Espera a transição acabar para sumir
    
    gameContainer.className = ''; 
    game.events.emit('LOGOUT_TRANSITION');
});
