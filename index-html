<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lumina Game - Full HD</title>
    <style>
        /* ==========================================
           RESET E CONTAINER PRINCIPAL
           ========================================== */
        body { margin: 0; padding: 0; background-color: #000; display: flex; justify-content: center; align-items: center; height: 100vh; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        #app-container { position: relative; width: 100vw; height: 100vh; display: flex; justify-content: center; align-items: center; }
        
        #game-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; transition: filter 0.8s ease; }
        .bg-blurred { filter: blur(12px) brightness(0.5); }
        .bg-light-blur { filter: blur(8px) brightness(0.6); }

        .ui-layer { position: absolute; z-index: 10; display: flex; flex-direction: column; justify-content: center; align-items: center; width: 100%; height: 100%; pointer-events: none; }
        .ui-element { pointer-events: auto; }

        /* ==========================================
           UI TELA DE TÍTULO (LOGIN/REGISTRO)
           ========================================== */
        #login-ui { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; transition: opacity 0.5s ease; }
        #initial-buttons { display: flex; gap: 30px; margin-top: 40vh; }

        @keyframes pulse-btn {
            0% { transform: scale(1); box-shadow: 0 0 15px rgba(0, 229, 255, 0.5); }
            50% { transform: scale(1.08); box-shadow: 0 0 30px rgba(0, 229, 255, 1); }
            100% { transform: scale(1); box-shadow: 0 0 15px rgba(0, 229, 255, 0.5); }
        }

        .btn-primary { padding: 15px 40px; font-size: 24px; font-weight: 900; background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); color: #111; text-transform: uppercase; border: 2px solid #00E5FF; border-radius: 50px; cursor: pointer; animation: pulse-btn 2s infinite ease-in-out; transition: background 0.3s ease; }
        .btn-primary:hover { background: linear-gradient(135deg, #FFE133 0%, #FFB733 100%); animation-play-state: paused; transform: scale(1.1); }

        .btn-secondary { padding: 15px 40px; font-size: 24px; font-weight: 900; background: rgba(10, 20, 30, 0.8); color: #00E5FF; text-transform: uppercase; border: 2px solid #00E5FF; border-radius: 50px; cursor: pointer; backdrop-filter: blur(5px); animation: pulse-btn 2s infinite ease-in-out 1s; transition: background 0.3s ease; }
        .btn-secondary:hover { background: rgba(0, 229, 255, 0.2); animation-play-state: paused; transform: scale(1.1); }

        #form-box { display: none; background: rgba(15, 20, 30, 0.75); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); padding: 40px 50px; border-radius: 20px; border: 1px solid rgba(0, 229, 255, 0.3); color: white; text-align: center; box-shadow: 0 15px 35px rgba(0,0,0,0.8), 0 0 20px rgba(0, 229, 255, 0.1); }
        #form-title { margin-top: 0; color: #FFD700; font-weight: 800; text-transform: uppercase; text-shadow: 0 0 10px rgba(255, 215, 0, 0.5); }
        #form-box input { display: block; width: 100%; box-sizing: border-box; padding: 15px; margin: 20px 0; border-radius: 8px; background: rgba(0, 0, 0, 0.6); color: #fff; border: 1px solid #555; font-size: 16px; transition: border 0.3s, box-shadow 0.3s; }
        #form-box input:focus { outline: none; border: 1px solid #00E5FF; box-shadow: 0 0 10px rgba(0, 229, 255, 0.3); }
        #btn-submit { padding: 15px 40px; font-size: 18px; font-weight: bold; text-transform: uppercase; background: linear-gradient(to bottom, #FFD700, #DAA520); color: #000; border: 2px solid #00E5FF; border-radius: 8px; cursor: pointer; width: 100%; margin-top: 10px; box-shadow: 0 0 15px rgba(0, 229, 255, 0.6); transition: all 0.3s ease; }
        #btn-submit:hover { background: linear-gradient(to bottom, #FFE55C, #E8B832); box-shadow: 0 0 25px rgba(0, 229, 255, 1); transform: translateY(-2px); }
        #btn-back { background: none; border: none; color: #aaa; font-size: 14px; margin-top: 15px; cursor: pointer; text-decoration: underline; transition: color 0.2s; }
        #btn-back:hover { color: #fff; }
        
        #loading-msg { display: none; color: #00E5FF; margin-top: 20px; font-weight: bold; text-shadow: 0 0 5px rgba(0, 229, 255, 0.5); font-size: 18px; }
        #auto-login-msg { display: none; color: #FFD700; margin-top: 40vh; font-size: 24px; font-weight: bold; text-shadow: 0 0 10px rgba(255, 215, 0, 0.8); }

        /* ==========================================
           UI TELA DE MENU PRINCIPAL
           ========================================== */
        #main-menu-ui { display: none; width: 100%; height: 100%; position: relative; }
        
        #main-menu-ui.active #btn-logout,
        #main-menu-ui.active #currency-hud {
            animation: fadeInMenu 1s forwards cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        #btn-logout { opacity: 0; position: absolute; top: 30px; left: 40px; background: rgba(10, 15, 25, 0.85); border: 1px solid rgba(0, 229, 255, 0.4); font-size: 32px; padding: 10px 15px; border-radius: 15px; cursor: pointer; backdrop-filter: blur(5px); transition: all 0.3s ease; color: white; display: flex; align-items: center; justify-content: center; }
        #btn-logout:hover { transform: rotate(90deg) scale(1.1); border-color: #00E5FF; filter: drop-shadow(0 0 10px rgba(0,229,255,0.8)); }

        #currency-hud { opacity: 0; position: absolute; top: 30px; right: 40px; background: rgba(10, 15, 25, 0.85); border: 1px solid rgba(0, 229, 255, 0.4); padding: 10px 25px; border-radius: 30px; display: flex; align-items: center; gap: 30px; backdrop-filter: blur(5px); }
        .hud-item { font-size: 20px; font-weight: bold; display: flex; align-items: center; gap: 10px; }
        .player-text { color: #fff; text-transform: uppercase; letter-spacing: 1px; }
        .gem-text { color: #00E5FF; text-shadow: 0 0 8px rgba(0, 229, 255, 0.6); font-size: 22px; }
        .hud-divider { width: 2px; height: 25px; background: rgba(255, 255, 255, 0.2); }

        #menu-buttons-container { display: flex; flex-direction: column; gap: 20px; justify-content: center; align-items: center; width: 100%; height: 100%; }
        
        /* ==========================================
           ESTRUTURA DOS CRISTAIS (BOTÃO + ÍCONE + TOOLTIP)
           ========================================== */
        
        /* O Wrapper segura o botão, o ícone "i" e a Tooltip como uma família */
        .menu-item-wrapper {
            position: relative;
            width: 450px;
            opacity: 0;
            transform: translateY(40px) scale(0.9);
            transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* O Botão (Diamante Lapidado) */
        .menu-action-btn { 
            width: 100%; 
            padding: 22px 20px; 
            font-size: 20px; font-weight: 900; text-transform: uppercase; letter-spacing: 3px; 
            background: linear-gradient(145deg, #232a35 0%, #11151c 100%);
            color: #a0aec0; border: none; cursor: pointer; text-align: center;
            clip-path: polygon(25px 0%, calc(100% - 25px) 0%, 100% 50%, calc(100% - 25px) 100%, 25px 100%, 0% 50%);
            box-shadow: inset 2px 2px 5px rgba(255, 255, 255, 0.1), inset -5px -5px 15px rgba(0, 0, 0, 0.9);
            transition: color 0.3s, background 0.3s;
        }

        /* Hover no Wrapper inteiro (aumenta o botão e acende as luzes) */
        .menu-item-wrapper:hover {
            transform: scale(1.05);
            filter: drop-shadow(0 10px 20px rgba(255, 215, 0, 0.4));
            z-index: 20; 
        }
        .menu-item-wrapper:hover .menu-action-btn {
            background: linear-gradient(145deg, #2d3748 0%, #1a202c 100%);
            color: #FFD700; 
        }
        
        /* Tema Específico do Botão Arena (Azul) */
        #btn-arena { color: #00E5FF; background: linear-gradient(145deg, #182b3a 0%, #0b151e 100%); }
        .menu-item-wrapper:hover #btn-arena { color: #ffffff; background: linear-gradient(145deg, #25425c 0%, #122230 100%); }
        #wrapper-arena:hover { filter: drop-shadow(0 10px 20px rgba(0, 229, 255, 0.4)); }

        /* ==========================================
           O ÍCONE DE INFORMAÇÃO ( i )
           ========================================== */
        .info-icon {
            position: absolute;
            right: 35px; /* Fica perfeitamente encaixado na borda reta do cristal */
            width: 28px; height: 28px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 215, 0, 0.4);
            border-radius: 50%;
            color: rgba(255, 215, 0, 0.8);
            font-family: 'Georgia', serif; /* Fonte serifada para deixar o 'i' com estilo elegante */
            font-size: 16px; font-style: italic; font-weight: bold;
            display: flex; justify-content: center; align-items: center;
            cursor: help;
            transition: all 0.3s ease;
            z-index: 2;
        }
        
        /* Acende o ícone quando passa o mouse no botão */
        .menu-item-wrapper:hover .info-icon {
            border-color: #FFD700; color: #FFD700; background: rgba(255, 215, 0, 0.1);
        }
        /* Efeito máximo quando passa o mouse direto no "i" */
        .info-icon:hover {
            background: rgba(255, 215, 0, 0.9) !important;
            color: #000 !important;
            box-shadow: 0 0 15px rgba(255, 215, 0, 0.8);
            transform: scale(1.2);
        }

        /* Cores exclusivas para o 'i' da Arena */
        #wrapper-arena .info-icon { border-color: rgba(0, 229, 255, 0.4); color: rgba(0, 229, 255, 0.8); }
        #wrapper-arena:hover .info-icon { border-color: #00E5FF; color: #00E5FF; background: rgba(0, 229, 255, 0.1); }
        #wrapper-arena .info-icon:hover { background: rgba(0, 229, 255, 0.9) !important; box-shadow: 0 0 15px rgba(0, 229, 255, 0.8); color: #000 !important; }

        /* ==========================================
           TOOLTIP (CAIXA DE TEXTO FLUTUANTE)
           ========================================== */
        .tooltip {
            position: absolute;
            left: calc(100% - 10px); /* Posicionado à direita do botão */
            background: rgba(10, 15, 25, 0.95);
            border: 1px solid #FFD700;
            color: #fff;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            letter-spacing: 1px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none; /* Deixa o mouse passar direto sem bugar */
            transform: translateX(0px);
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            box-shadow: 0 5px 15px rgba(0,0,0,0.8);
            z-index: 10;
            backdrop-filter: blur(5px);
        }
        #wrapper-arena .tooltip { border-color: #00E5FF; }

        /* A MÁGICA: Revela o Tooltip SOMENTE quando passa o mouse no Ícone ( ~ é o seletor de irmão ) */
        .info-icon:hover ~ .tooltip {
            opacity: 1;
            transform: translateX(20px); /* Desliza elegantemente para fora */
        }

        /* ==========================================
           ANIMAÇÃO EM CASCATA DA ESCADA DE BOTÕES
           ========================================== */
        @keyframes fadeInMenu {
            0% { opacity: 0; transform: translateY(40px) scale(0.9); filter: drop-shadow(0 0 0 rgba(0,0,0,0)); }
            100% { opacity: 1; transform: translateY(0) scale(1); filter: drop-shadow(0 15px 25px rgba(0,0,0,0.8)); }
        }

        /* Cada botão entra com 0.1s de diferença do outro */
        #main-menu-ui.active .menu-item-wrapper:nth-child(1) { animation: fadeInMenu 0.6s forwards cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s; }
        #main-menu-ui.active .menu-item-wrapper:nth-child(2) { animation: fadeInMenu 0.6s forwards cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s; }
        #main-menu-ui.active .menu-item-wrapper:nth-child(3) { animation: fadeInMenu 0.6s forwards cubic-bezier(0.2, 0.8, 0.2, 1) 0.3s; }
        #main-menu-ui.active .menu-item-wrapper:nth-child(4) { animation: fadeInMenu 0.6s forwards cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s; }

    </style>
</head>
<body>
    <div id="app-container">
        <div id="game-container"></div>

        <div class="ui-layer">
            
            <div id="login-ui" class="ui-element">
                <div id="auto-login-msg">Conectando a Lumina...</div>
                <div id="initial-buttons">
                    <button id="btn-login" class="btn-secondary">Jogador Existente</button>
                    <button id="btn-new-game" class="btn-primary">Novo Jogo</button>
                </div>
                <div id="form-box">
                    <h2 id="form-title">Registrar no Lumina</h2>
                    <input type="email" id="userEmail" placeholder="Seu E-mail" required autocomplete="email">
                    <input type="password" id="userPass" placeholder="Sua Senha" required autocomplete="new-password">
                    <button id="btn-submit">Criar Conta</button><br>
                    <button id="btn-back">Voltar</button>
                    <p id="loading-msg">Conectando ao servidor...</p>
                </div>
            </div>

            <div id="main-menu-ui" class="ui-element">
                
                <button id="btn-logout" title="Sair / Trocar Conta">⚙️</button>

                <div id="currency-hud">
                    <div class="hud-item player-text"><span>👤</span> <span id="display-username">JOGADOR</span></div>
                    <div class="hud-divider"></div>
                    <div class="hud-item gem-text"><span>💎</span> <span id="display-gems">0</span></div>
                </div>

                <div id="menu-buttons-container">
                    
                    <div class="menu-item-wrapper" id="wrapper-arena">
                        <button class="menu-action-btn" id="btn-arena">Arena</button>
                        <div class="info-icon">i</div>
                        <div class="tooltip">Partidas pvp</div>
                    </div>

                    <div class="menu-item-wrapper">
                        <button class="menu-action-btn">Partida Casual</button>
                        <div class="info-icon">i</div>
                        <div class="tooltip">Partidas contra a IA</div>
                    </div>

                    <div class="menu-item-wrapper">
                        <button class="menu-action-btn">A Oficina do Destino</button>
                        <div class="info-icon">i</div>
                        <div class="tooltip">Forja e fortalecimento dos cards</div>
                    </div>

                    <div class="menu-item-wrapper">
                        <button class="menu-action-btn">Biblioteca Mágica</button>
                        <div class="info-icon">i</div>
                        <div class="tooltip">Builds de decks</div>
                    </div>

                </div>
            </div>

        </div>
    </div>
    
    <script type="module" src="/src/main.js"></script>
</body>
</html>
